# Copy to .env and fill in. Only TARGET_URL is required.
# Run these checks only against a site you own or have written permission to test.

# The page the checks start from, e.g. https://www.example.com/
TARGET_URL=

# Hosts the suite may navigate to or request, comma-separated. Defaults to TARGET_URL's host only.
# Anything else (a redirect elsewhere, a link to another site, a sitemap entry on another host) is never requested.
ALLOWED_HOSTS=

# Where the page list comes from. Defaults to <TARGET_URL origin>/sitemap.xml. Sitemap indexes are followed.
SITEMAP_URL=

# Or list the pages yourself, comma-separated paths or URLs; this replaces the sitemap.
PAGES=

# How many pages to check (spread evenly across the sitemap). Default 20.
MAX_PAGES=

# HTTP basic auth, if the site sits behind it. Sent to the target origin only.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Parallel browsers. Default 1, to stay polite to the site; raise only for a site that can take it.
WORKERS=
